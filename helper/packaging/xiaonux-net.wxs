<?xml version="1.0" encoding="utf-8"?>
<!-- Windows installer for xiaonux-net, built with wixl (msitools) by release.sh -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="xiaonux-net" Language="1033" Version="@VERSION@"
           Manufacturer="xiaonux" UpgradeCode="5b0a4f1e-6c1d-4a8e-9f3b-2d7c8e1a9b40">
    <Package InstallerVersion="200" Compressed="yes" InstallScope="perUser"
             Description="Lets the xiaonux browser VM use this computer's internet" />
    <MajorUpgrade DowngradeErrorMessage="A newer xiaonux-net is already installed." />
    <Media Id="1" Cabinet="xiaonux.cab" EmbedCab="yes" />
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="Programs" Name="Programs">
          <Directory Id="INSTALLDIR" Name="xiaonux-net">
            <Component Id="MainExe" Guid="8d3e2c41-0f6a-4b7e-a1c9-3e5f7a2b6c18">
              <File Id="XiaonuxNetExe" Name="xiaonux-net.exe" Source="xiaonux-net.exe" KeyPath="yes" />
              <RemoveFolder Id="RemoveInstallDir" On="uninstall" />
            </Component>
          </Directory>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Component Id="StartMenu" Guid="a7c4e8b2-3d1f-4c6a-8e9b-1f2d3c4b5a69">
          <Shortcut Id="StartShortcut" Name="xiaonux-net" Description="Share this computer's internet with xiaonux"
                    Target="[INSTALLDIR]xiaonux-net.exe" WorkingDirectory="INSTALLDIR" />
          <RegistryValue Root="HKCU" Key="Software\xiaonux\xiaonux-net" Name="installed" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </Directory>
    <Feature Id="Main" Level="1">
      <ComponentRef Id="MainExe" />
      <ComponentRef Id="StartMenu" />
    </Feature>
  </Product>
</Wix>
