  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Solid cover-stock blue; the one action that matters (Start Linux, Download).",
      "html": "<button class=\"ds-btn-primary\">Start Linux</button>",
      "css": ".ds-btn-primary{font:600 14px/1 var(--sans);background:var(--blue);color:var(--on-blue);border:1px solid transparent;border-radius:var(--radius);padding:10px 16px;cursor:pointer;transition:background-color 160ms var(--ease)}.ds-btn-primary:hover{background:var(--blue-hover)}.ds-btn-primary:focus-visible{outline:2px solid var(--blue);outline-offset:2px}.ds-btn-primary:disabled{opacity:.55;cursor:progress}"
    },
    {
      "name": "Quiet Button",
      "kind": "button",
      "refersTo": "button-quiet",
      "description": "Ruled outline in blue text; secondary actions such as Try it and Cancel.",
      "html": "<button class=\"ds-btn-quiet\">Try it</button>",
      "css": ".ds-btn-quiet{font:600 14px/1 var(--sans);background:transparent;color:var(--blue);border:1px solid var(--rule-strong);border-radius:var(--radius);padding:10px 16px;cursor:pointer;transition:background-color 160ms var(--ease),border-color 160ms var(--ease)}.ds-btn-quiet:hover{background:var(--blue-wash);border-color:var(--blue)}.ds-btn-quiet:focus-visible{outline:2px solid var(--blue);outline-offset:2px}"
    },
    {
      "name": "Top Bar",
      "kind": "nav",
      "refersTo": "bar",
      "description": "The blue binding over the terminal: wordmark, live status, network chip, icon buttons.",
      "html": "<header class=\"ds-bar\"><span class=\"ds-wm\">xiaonux</span><span class=\"ds-status\">Ready in 0.48 s</span><button class=\"ds-chip\"><span class=\"ds-dot\"></span>Internet off</button><span style=\"flex:1\"></span><button class=\"ds-bar-btn\"><svg viewBox=\"0 0 20 20\" aria-hidden=\"true\"><path d=\"M10 13V3M6 7l4-4 4 4M4 13v3h12v-3\"/></svg>Upload</button><button class=\"ds-bar-btn\" aria-expanded=\"true\"><svg viewBox=\"0 0 20 20\" aria-hidden=\"true\"><path d=\"M3 4h14v12H3zM12 4v12\"/></svg>Guide</button></header>",
      "css": ".ds-bar{display:flex;align-items:center;gap:8px 14px;min-height:48px;padding:6px 10px 6px 16px;background:var(--bar);color:var(--bar-ink);font-family:var(--sans)}.ds-wm{font:700 17px/1 var(--sans);letter-spacing:-.01em}.ds-status{font-size:13px;color:var(--bar-ink-2);font-variant-numeric:tabular-nums;min-width:16ch}.ds-chip{display:inline-flex;align-items:center;gap:8px;font:500 13px/1 var(--sans);color:var(--bar-ink);background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.22);border-radius:999px;padding:6px 12px;cursor:pointer}.ds-chip:hover{background:rgba(255,255,255,.16)}.ds-dot{width:8px;height:8px;border-radius:50%;background:var(--bar-ink-2)}.ds-bar-btn{display:inline-flex;align-items:center;gap:6px;font:500 13px/1 var(--sans);color:var(--bar-ink);background:transparent;border:1px solid transparent;border-radius:var(--radius);padding:7px 10px;cursor:pointer}.ds-bar-btn:hover{background:rgba(255,255,255,.12)}.ds-bar-btn[aria-expanded=true]{background:rgba(255,255,255,.16);border-color:rgba(255,255,255,.22)}.ds-bar-btn:focus-visible,.ds-chip:focus-visible{outline:2px solid var(--bar-ink);outline-offset:2px}.ds-bar-btn svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}"
    },
    {
      "name": "Drawer Tabs",
      "kind": "nav",
      "refersTo": "tab",
      "description": "Worksheet sections; selected tab is blue text on a blue 2px underline.",
      "html": "<div class=\"ds-tabs\" role=\"tablist\"><button role=\"tab\" aria-selected=\"true\">Guides</button><button role=\"tab\" aria-selected=\"false\">Network</button><button role=\"tab\" aria-selected=\"false\">Safety</button></div>",
      "css": ".ds-tabs{display:flex;gap:4px;padding:10px 16px 0;border-bottom:1px solid var(--rule);background:var(--paper)}.ds-tabs [role=tab]{font:600 13.5px/1 var(--sans);color:var(--ink-2);background:none;border:0;border-bottom:2px solid transparent;padding:10px 10px 11px;margin-bottom:-1px;cursor:pointer}.ds-tabs [role=tab]:hover{color:var(--ink)}.ds-tabs [role=tab][aria-selected=true]{color:var(--blue);border-bottom-color:var(--blue)}.ds-tabs [role=tab]:focus-visible{outline:2px solid var(--blue);outline-offset:2px}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Sheet-filled field with stacked semibold label; mono for paths.",
      "html": "<label class=\"ds-field\"><span>File to download (under /root)</span><input type=\"text\" value=\"/root/\"></label>",
      "css": ".ds-field{display:grid;gap:6px;font:600 13px/1.3 var(--sans);color:var(--ink-2)}.ds-field input{font:500 13.5px/1.3 var(--mono);color:var(--ink);background:var(--sheet);border:1px solid var(--rule-strong);border-radius:var(--radius);padding:8px 10px}.ds-field input:hover{border-color:var(--blue)}.ds-field input:focus-visible{outline:2px solid var(--blue);outline-offset:2px}"
    },
    {
      "name": "Network Option Card",
      "kind": "chip",
      "refersTo": "option-card",
      "description": "Radio as a whole ruled card; checked card takes blue border and blue wash.",
      "html": "<label class=\"ds-opt\"><input type=\"radio\" name=\"ds-n\" checked><span><b>Off</b> Nothing leaves this tab.</span></label><label class=\"ds-opt\"><input type=\"radio\" name=\"ds-n\"><span><b>This computer</b> Through the small xiaonux-net helper.</span></label>",
      "css": ".ds-opt{display:grid;grid-template-columns:auto 1fr;gap:10px;align-items:start;padding:10px 12px;margin-bottom:8px;background:var(--sheet);border:1px solid var(--rule);border-radius:var(--radius);font:13.5px/1.4 var(--sans);color:var(--ink-2);cursor:pointer}.ds-opt:has(input:checked){border-color:var(--blue);background:var(--blue-wash)}.ds-opt b{display:block;color:var(--ink);font-size:14px}.ds-opt input{margin:3px 0 0;accent-color:var(--blue)}"
    },
    {
      "name": "Worksheet",
      "kind": "custom",
      "refersTo": "worksheet",
      "description": "Ruled numbered rows on a near-square sheet, numbers in a printed margin.",
      "html": "<div class=\"ds-sheet\"><p class=\"ds-sheet-head\"><b>Guides</b><span>Commands typed for you, checked when they run</span></p><ol class=\"ds-rows\"><li><div><h2>Learn Unix</h2><p>Files, pipes, permissions and processes.</p></div><button class=\"ds-btn-quiet\">Try it</button></li><li><div><h2>Python &amp; packages</h2><p>Python 3 with pip.</p></div><button class=\"ds-btn-quiet\">Try it</button></li></ol></div>",
      "css": ".ds-sheet{background:var(--sheet);border:1px solid var(--rule);border-radius:2px;font-family:var(--sans);color:var(--ink)}.ds-sheet-head{display:flex;justify-content:space-between;gap:12px;margin:0;padding:12px 20px 10px 64px;border-bottom:2px solid var(--rule-strong);font-size:13px;color:var(--ink-2)}.ds-sheet-head b{color:var(--ink)}.ds-rows{list-style:none;margin:0;padding:0;counter-reset:row;background:linear-gradient(90deg,transparent 51px,var(--margin) 51px,var(--margin) 52px,transparent 52px)}.ds-rows li{counter-increment:row;display:grid;grid-template-columns:36px 1fr auto;align-items:center;gap:4px 28px;padding:20px 24px 20px 0;border-bottom:1px solid var(--rule)}.ds-rows li:last-child{border-bottom:0}.ds-rows li::before{content:counter(row);align-self:start;justify-self:end;font:600 13px/1.4 var(--sans);color:var(--ink-2);font-variant-numeric:tabular-nums}.ds-rows h2{font-size:19px;line-height:1.3;margin:0 0 4px;letter-spacing:-.01em}.ds-rows p{margin:0;color:var(--ink-2);font-size:14.5px}.ds-btn-quiet{font:600 14px/1 var(--sans);background:transparent;color:var(--blue);border:1px solid var(--rule-strong);border-radius:var(--radius);padding:10px 16px;cursor:pointer;transition:background-color 160ms var(--ease),border-color 160ms var(--ease)}.ds-btn-quiet:hover{background:var(--blue-wash);border-color:var(--blue)}.ds-btn-quiet:focus-visible{outline:2px solid var(--blue);outline-offset:2px}"
    },
    {
      "name": "Guide Step with Red-Pen Check",
      "kind": "custom",
      "refersTo": "step-mark",
      "description": "Numbered ring that becomes a hand-drawn red-pen check when the command has run; command row with Type it.",
      "html": "<ol class=\"ds-steps\"><li class=\"ds-step ds-done\"><span class=\"ds-mark\"><span class=\"ds-num\">1</span><svg class=\"ds-check\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 13l5 5L20 5\"/></svg></span><div><p>Look at the file type.</p><div class=\"ds-cmd\"><code>file sample.sh</code><button class=\"ds-btn-quiet ds-sm\">Type it</button></div></div></li><li class=\"ds-step\"><span class=\"ds-mark\"><span class=\"ds-num\">2</span><svg class=\"ds-check\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 13l5 5L20 5\"/></svg></span><div><p>Record its fingerprint.</p><div class=\"ds-cmd\"><code>sha256sum sample.sh</code><button class=\"ds-btn-quiet ds-sm\">Type it</button></div></div></li></ol>",
      "css": ".ds-steps{list-style:none;margin:0;padding:0;border-top:1px solid var(--rule);font-family:var(--sans)}.ds-step{display:grid;grid-template-columns:32px minmax(0,1fr);gap:10px;padding:12px 0;border-bottom:1px solid var(--rule)}.ds-step p{margin:2px 0 8px;color:var(--ink);font-size:14px}.ds-done p{color:var(--ink-2)}.ds-mark{position:relative;width:28px;height:28px;display:grid;place-items:center;border:1px solid var(--rule-strong);border-radius:50%;color:var(--ink-2)}.ds-num{font:600 12.5px/1 var(--sans);font-variant-numeric:tabular-nums}.ds-check{position:absolute;left:1px;top:-5px;width:30px;height:30px;fill:none;stroke:var(--pen);stroke-width:3;stroke-linecap:round;stroke-linejoin:round;stroke-dasharray:30;stroke-dashoffset:30}.ds-done .ds-mark{border-color:transparent}.ds-done .ds-num{opacity:.35}.ds-done .ds-check{stroke-dashoffset:0;animation:ds-pen 420ms var(--ease) both}@keyframes ds-pen{from{stroke-dashoffset:30}}.ds-cmd{display:flex;align-items:flex-start;gap:8px;background:var(--sheet);border:1px solid var(--rule);border-radius:var(--radius);padding:6px 6px 6px 10px}.ds-cmd code{flex:1;padding:4px 0 2px;font:12.5px/1.45 var(--mono);color:var(--ink);white-space:pre}.ds-btn-quiet{font:600 14px/1 var(--sans);background:transparent;color:var(--blue);border:1px solid var(--rule-strong);border-radius:var(--radius);padding:10px 16px;cursor:pointer;transition:background-color 160ms var(--ease),border-color 160ms var(--ease)}.ds-btn-quiet:hover{background:var(--blue-wash);border-color:var(--blue)}.ds-btn-quiet:focus-visible{outline:2px solid var(--blue);outline-offset:2px}.ds-sm{font-size:13px;padding:6px 10px}"
    }
  ],
  "narrative": {
    "northStar": "The Lab Worksheet Beside the Machine",
    "overview": "xiaonux looks like a university lab session: a terminal that fills the room, and a printed worksheet beside it. The ground is bond-white paper, the shell is bound in cover-stock blue, text is graphite, worksheet rows sit on faint blue ruling with their numbers in a printed margin, and the only red on the page is the teacher's pen marking what has happened. Dark mode is the same sheet in blue-black ink wash, with the blue and the red lifted rather than swapped for new hues.\n\nThe system is quiet and dense in the way working documents are dense. Colour carries meaning, not mood: blue means \"you can press this\" (plus the top bar that frames the machine), red means \"a state was marked\", green means \"done/connected\". Everything else is paper, ink and ruling. The terminal is the product, so the shell gets the room and the worksheet lives in a drawer that can close.\n\nThe world refuses the category default for in-browser Linux: a black page with a neon accent and a terminal floating in a fake window. Here the terminal is the surface itself, edge to edge under the bar, on the same sheet colour as the worksheet.",
    "keyCharacteristics": [
      "Paper ground, sheet surfaces, graphite ink, blue ruling lines instead of boxes and shadows.",
      "Cover-stock blue on the top bar and on pressable things only.",
      "Red pen reserved for state marks: hand-drawn checks, guide progress, errors and blocked states.",
      "A pale printed margin rule separating row numbers from row text.",
      "System sans for everything; monospace only for commands, paths and the terminal.",
      "Status readouts in fixed-width cells with tabular numerals, so changing numbers never move the layout.",
      "Light and dark from the same role tokens via `prefers-color-scheme`."
    ],
    "rules": [
      {
        "name": "The Pressable Blue Rule",
        "body": "Blue fills and blue text belong to the top bar and to things you can press (buttons, links, tabs, selected options, focus). A heading or a decoration is never blue.",
        "section": "colors"
      },
      {
        "name": "The Red Pen Rule",
        "body": "`pen` marks state that has happened: a check, progress, an error, a block. If nothing changed, nothing is red.",
        "section": "colors"
      },
      {
        "name": "The Printed Margin Rule",
        "body": "The margin line is `margin`, never `pen`. Printed furniture and teacher's marks stay different colours.",
        "section": "colors"
      },
      {
        "name": "The Mono Means Machine Rule",
        "body": "Monospace appears only where text is something you type or the machine prints: commands, paths, code, the terminal.",
        "section": "typography"
      },
      {
        "name": "The Fixed Cell Rule",
        "body": "Changing numbers (status, MIPS, timings, row numbers, counts) use tabular numerals and a reserved min-width, so updates never shift neighbours.",
        "section": "typography"
      },
      {
        "name": "The Paper Doesn't Float Rule",
        "body": "Resting surfaces (worksheet, panels, cards, option cards) get a 1px rule border and no shadow. A shadow means \"this is on top and will go away\".",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep blue for the top bar and pressable things: buttons, links, tabs, selected options, focus rings.",
      "Do use `pen` only for marks of state: checks, progress, errors, blocked.",
      "Do separate surfaces with 1px `rule` lines and the `paper`/`sheet` tone step before reaching for anything else.",
      "Do keep finished steps visible and checked; completed work never disappears.",
      "Do put changing numbers in fixed-width cells with tabular numerals.",
      "Do derive every dark-mode value from the same role (lift blue and pen; ink-wash ground), and keep the xterm palette in step with the role tokens.",
      "Do honour `prefers-reduced-motion` by collapsing animations and transitions to 1ms.",
      "Do keep touch targets at 44px on the touch-key row."
    ],
    "donts": [
      "Don't make the product a black page with a neon accent and a terminal in a floating window.",
      "Don't colour headings or decorations blue to add emphasis.",
      "Don't use `pen` red for decoration, emphasis or the printed margin.",
      "Don't put shadows on resting surfaces; the floating-layer shadow is for popover, toast and overlay drawer only.",
      "Don't load web fonts; the first prompt's load time outranks a custom face.",
      "Don't set prose, labels or headings in monospace."
    ]
  }
}
