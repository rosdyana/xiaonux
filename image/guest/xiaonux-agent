#!/usr/bin/python3
"""xiaonux guest agent: line commands from the page on /dev/hvc1.

  seed <hex>          mix host entropy into the kernel pool and reseed the CRNG
  time <unix_ms>      set the wall clock
  size <cols> <rows>  set the terminal size of /dev/hvc0
  ping                liveness
  put <size> <name>   start an upload into /root/uploads/<name>
  chunk <base64>      next piece of the upload (no reply)
  end <sha256>        finish the upload; checked against size and hash
  get <path>          send a file back (only under /root): replies
                      "file <size> <sha256>", then "data <base64>" lines,
                      then "ok get"

Each command is answered with "ok <cmd> [...]" or "err <cmd> <reason>".
After a snapshot restore the page sends seed + time before showing the
prompt, so every visitor gets their own random state and the right date.

Copyright (c) 2026 xiaonux authors. SPDX-License-Identifier: Apache-2.0
"""
import base64, fcntl, hashlib, os, struct, termios, time, tty

RNDADDENTROPY = 0x40085203  # _IOW('R', 0x03, int[2])
RNDRESEEDCRNG = 0x5207      # _IO('R', 0x07)
UPLOADS = "/root/uploads"
MAX_FILE = 256 << 20        # 256 MB either way
CHUNK = 48 * 1024           # raw bytes per "data" line on download

upload = None  # {"name", "size", "f", "hash", "got"}


def safe_name(name: str) -> str:
    name = os.path.basename(name.replace("\\", "/")).strip() or "upload"
    return "".join(c if c.isalnum() or c in "._-+" else "_" for c in name)[:200]


def handle(line: str, out) -> str:
    global upload
    parts = line.split()
    if not parts:
        return ""
    cmd, args = parts[0], parts[1:]
    if cmd == "seed":
        data = bytes.fromhex(args[0])
        with open("/dev/random", "wb") as r:
            fcntl.ioctl(r, RNDADDENTROPY, struct.pack("ii", len(data) * 8, len(data)) + data)
            # The CRNG only reseeds from the pool on a timer; force it now,
            # or a restored snapshot keeps producing the same numbers.
            fcntl.ioctl(r, RNDRESEEDCRNG)
    elif cmd == "time":
        time.clock_settime(time.CLOCK_REALTIME, int(args[0]) / 1000)
    elif cmd == "size":
        cols, rows = int(args[0]), int(args[1])
        fd = os.open("/dev/hvc0", os.O_RDWR | os.O_NOCTTY)
        try:
            fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack("HHHH", rows, cols, 0, 0))
        finally:
            os.close(fd)
    elif cmd == "put":
        size = int(args[0])
        if size > MAX_FILE:
            return "err put too-large\n"
        os.makedirs(UPLOADS, mode=0o700, exist_ok=True)
        name = safe_name(" ".join(args[1:]))
        if upload:
            upload["f"].close()
        upload = {"name": name, "size": size, "got": 0, "hash": hashlib.sha256(),
                  "f": open(os.path.join(UPLOADS, name + ".part"), "wb")}
        return f"ok put {name}\n"
    elif cmd == "chunk":
        if not upload:
            return ""
        data = base64.b64decode(args[0])
        upload["f"].write(data)
        upload["hash"].update(data)
        upload["got"] += len(data)
        return ""
    elif cmd == "end":
        if not upload:
            return "err end no-upload\n"
        u, upload = upload, None
        u["f"].close()
        part = os.path.join(UPLOADS, u["name"] + ".part")
        if u["got"] != u["size"] or u["hash"].hexdigest() != args[0]:
            os.unlink(part)
            return "err end mismatch\n"
        final = os.path.join(UPLOADS, u["name"])
        os.replace(part, final)
        os.chmod(final, 0o600)  # never executable by default
        return f"ok end {final}\n"
    elif cmd == "get":
        path = os.path.realpath(os.path.join("/root", " ".join(args)))
        if not (path == "/root" or path.startswith("/root/")) or not os.path.isfile(path):
            return "err get not-a-file-under-/root\n"
        size = os.path.getsize(path)
        if size > MAX_FILE:
            return "err get too-large\n"
        h = hashlib.sha256()
        with open(path, "rb") as f:
            for block in iter(lambda: f.read(1 << 20), b""):
                h.update(block)
        out(f"file {size} {h.hexdigest()}\n".encode())
        with open(path, "rb") as f:
            for block in iter(lambda: f.read(CHUNK), b""):
                out(b"data " + base64.b64encode(block) + b"\n")
    elif cmd != "ping":
        return f"err {cmd} unknown\n"
    return f"ok {cmd}\n"


def lock_memory():
    """Stay resident: the snapshot build drops page caches, and an agent that
    has to fault its own code back in from disk answers too late after a
    restore (the prompt would appear before the clock and entropy are fixed)."""
    import ctypes
    MCL_CURRENT, MCL_FUTURE = 1, 2
    try:
        ctypes.CDLL(None, use_errno=True).mlockall(MCL_CURRENT | MCL_FUTURE)
    except Exception:
        pass


def main():
    lock_memory()
    fd = os.open("/dev/hvc1", os.O_RDWR | os.O_NOCTTY)
    tty.setraw(fd)

    def out(b: bytes):
        while b:
            n = os.write(fd, b)
            b = b[n:]

    buf = bytearray()
    while True:
        data = os.read(fd, 65536)
        if not data:
            time.sleep(0.1)
            continue
        buf += data
        while True:
            i = buf.find(b"\n")
            if i < 0:
                break
            line = buf[:i].decode("ascii", "replace").strip()
            del buf[:i + 1]
            try:
                reply = handle(line, out)
            except Exception as e:  # report and keep serving
                reply = f"err {line.split()[0] if line else '?'} {type(e).__name__}\n"
            if reply:
                out(reply.encode())


if __name__ == "__main__":
    main()
