#!/usr/bin/python3
"""xiaonux guest agent: line commands from the page on /dev/hvc1.

  seed <hex>          mix host entropy into the kernel pool and reseed the CRNG
  time <unix_ms>      set the wall clock
  size <cols> <rows>  set the terminal size of /dev/hvc0
  ping                liveness

Each command is answered with "ok <cmd>" or "err <cmd> <reason>".
After a snapshot restore the page sends seed + time before showing the
prompt, so every visitor gets their own random state and the right date.
"""
import fcntl, os, struct, sys, termios, time, tty

RNDADDENTROPY = 0x40085203  # _IOW('R', 0x03, int[2])
RNDRESEEDCRNG = 0x5207      # _IO('R', 0x07)


def handle(line: str) -> str:
    parts = line.split()
    if not parts:
        return ""
    cmd, args = parts[0], parts[1:]
    if cmd == "seed":
        data = bytes.fromhex(args[0])
        with open("/dev/random", "wb") as r:
            fcntl.ioctl(r, RNDADDENTROPY, struct.pack("ii", len(data) * 8, len(data)) + data)
            # The CRNG only reseeds from the pool on a timer; force it now,
            # or a restored snapshot keeps producing the same numbers.
            fcntl.ioctl(r, RNDRESEEDCRNG)
    elif cmd == "time":
        time.clock_settime(time.CLOCK_REALTIME, int(args[0]) / 1000)
    elif cmd == "size":
        cols, rows = int(args[0]), int(args[1])
        fd = os.open("/dev/hvc0", os.O_RDWR | os.O_NOCTTY)
        try:
            fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack("HHHH", rows, cols, 0, 0))
        finally:
            os.close(fd)
    elif cmd != "ping":
        return f"err {cmd} unknown\n"
    return f"ok {cmd}\n"


def main():
    fd = os.open("/dev/hvc1", os.O_RDWR | os.O_NOCTTY)
    tty.setraw(fd)
    buf = b""
    while True:
        data = os.read(fd, 4096)
        if not data:
            time.sleep(0.1)
            continue
        buf += data
        while b"\n" in buf:
            raw, buf = buf.split(b"\n", 1)
            line = raw.decode("ascii", "replace").strip()
            try:
                reply = handle(line)
            except Exception as e:  # report and keep serving
                reply = f"err {line.split()[0] if line else '?'} {type(e).__name__}\n"
            if reply:
                os.write(fd, reply.encode())


if __name__ == "__main__":
    main()
