# xiaonux kernel fragment, merged over arch/riscv defconfig.
# Everything built in: no modules, no initrd.
# CONFIG_MODULES is not set
# CONFIG_BLK_DEV_INITRD is not set
# CONFIG_EFI is not set

# TinyEMU devices
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HVC_DRIVER=y
CONFIG_SERIAL_EARLYCON_RISCV_SBI=y
CONFIG_HVC_RISCV_SBI=y

# Root filesystem and what systemd needs
CONFIG_EXT4_FS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_FHANDLE=y
CONFIG_AUTOFS_FS=y
CONFIG_CGROUPS=y
CONFIG_INOTIFY_USER=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y
CONFIG_UNIX=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y

# TinyEMU is RV64GC: no vector or other optional extensions in the kernel.
# CONFIG_RISCV_ISA_V is not set
# CONFIG_RISCV_ISA_ZBB is not set
# CONFIG_RISCV_ISA_ZICBOM is not set
# CONFIG_RISCV_ISA_ZICBOZ is not set
# CONFIG_RISCV_ISA_SVPBMT is not set
# CONFIG_RISCV_ISA_SVNAPOT is not set

# Things a browser VM never has
# CONFIG_PCI is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_DRM is not set
# CONFIG_SOUND is not set
# CONFIG_WIRELESS is not set
# CONFIG_WLAN is not set
# CONFIG_INPUT_MOUSE is not set
# CONFIG_INPUT_KEYBOARD is not set
# CONFIG_MMC is not set
# CONFIG_DEBUG_INFO is not set
